local RS = game:GetService("ReplicatedStorage")
local LP = game:GetService("Players").LocalPlayer
local UIS = game:GetService("UserInputService")
local Net = RS:WaitForChild("Network", 10)
if not Net then warn("[MATRIX] Network folder not found!") return end

local function RE(n)
    local p = n:split(":")
    if #p == 2 then
        local f = Net:FindFirstChild(p[1])
        return f and f:FindFirstChild(p[2]) or nil
    end
    return Net:FindFirstChild(n)
end
local RF = RE
local R = RE

-- Draggable
local function makeDraggable(frame, handle)
    local dragging, dragInput, dragStart, startPos
    handle.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = frame.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    handle.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)
    UIS.InputChanged:Connect(function(input)
        if dragging and input == dragInput then
            local d = input.Position - dragStart
            frame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + d.X, startPos.Y.Scale, startPos.Y.Offset + d.Y)
        end
    end)
end

-- Matrix Rain
local function CreateMatrixRain(parent)
    local c = Instance.new("Frame")
    c.Name = "MatrixRain"
    c.Size = UDim2.new(1, 0, 1, 0)
    c.BackgroundTransparency = 1
    c.ZIndex = 0
    c.ClipsDescendants = true
    c.Parent = parent
    local chars = "ｱｲｳｴｵｶｷｸｹｺｻｼｽｾｿﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾖﾗﾘﾙﾚﾛﾜﾝ0123456789ABCDEF"
    local cols = {}
    for i = 1, 38 do
        local lb = Instance.new("TextLabel")
        lb.Size = UDim2.new(0, 14, 1, 0)
        lb.Position = UDim2.new(0, (i-1)*18, 0, 0)
        lb.BackgroundTransparency = 1
        lb.Font = Enum.Font.Code
        lb.TextSize = 12
        lb.TextColor3 = Color3.fromRGB(0, 180, 0)
        lb.TextXAlignment = Enum.TextXAlignment.Left
        lb.Text = ""
        lb.ZIndex = 1
        lb.Parent = c
        cols[i] = {label = lb, y = math.random(-50, 0), speed = math.random(2, 8)/10}
    end
    spawn(function()
        while c and c.Parent do
            for _, col in ipairs(cols) do
                if math.random(1, 5) == 1 then
                    local a, b = math.random(1, #chars), math.random(1, #chars)
                    col.label.Text = (a <= b) and chars:sub(a, b) or chars:sub(b, a)
                    col.label.Position = UDim2.new(col.label.Position.X.Scale, col.label.Position.X.Offset, 0, col.y)
                    col.y = col.y + col.speed * 3
                    if col.y > 500 then col.y = math.random(-80, -20) end
                    col.label.TextTransparency = math.random(20, 60) / 100
                end
            end
            wait(0.08)
        end
    end)
end

