-- // TAB SWITCHING
-- ═══════════════════════════════════════════════════════════
local tabBuilders = {
    Main = BuildMainTab,
    Treadmill = BuildTreadmillTab,
    Assets = BuildAssetsTab,
    Guards = BuildGuardsTab,
    Trading = BuildTradingTab,
    Misc = BuildMiscTab
}

local function SwitchTab(name)
    if not tabBuilders[name] then return end
    for n, btn in pairs(tabButtons) do
        btn.BackgroundColor3 = Color3.fromRGB(0, 20, 0)
        btn.TextColor3 = Color3.fromRGB(0, 200, 0)
        btn.Text = "> " .. n
        btn.Active = false
    end
    tabButtons[name].BackgroundColor3 = Color3.fromRGB(0, 60, 0)
    tabButtons[name].TextColor3 = Color3.fromRGB(0, 255, 100)
    tabButtons[name].Text = ">> " .. name
    tabButtons[name].Active = true
    tabBuilders[name]()
    Log("[TAB] " .. name)
end

for name, btn in pairs(tabButtons) do
    btn.MouseButton1Click:Connect(function() SwitchTab(name) end)
end

