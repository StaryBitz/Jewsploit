-- // TAB SWITCHING
-- ═══════════════════════════════════════════════════════════
local tabBuilders = {
    Main = BuildMainTab,
    Treadmill = BuildTreadmillTab,
    Assets = BuildAssetsTab,
    Guards = BuildGuardsTab,
    Trading = BuildTradingTab,
    Misc = BuildMiscTab
}

local currentTab = "Main"

local function SwitchTab(tabName)
    if tabBuilders[tabName] then
        currentTab = tabName
        -- Reset all tab button colors
        for name, btn in pairs(tabButtons) do
            btn.BackgroundColor3 = Color3.fromRGB(0, 20, 0)
            btn.TextColor3 = Color3.fromRGB(0, 200, 0)
            btn.Text = "> " .. name
            btn.Active = false
        end
        -- Highlight active tab
        tabButtons[tabName].BackgroundColor3 = Color3.fromRGB(0, 60, 0)
        tabButtons[tabName].TextColor3 = Color3.fromRGB(0, 255, 100)
        tabButtons[tabName].Text = ">> " .. tabName
        tabButtons[tabName].Active = true
        -- Build tab content
        tabBuilders[tabName]()
        Log("[TAB] Switched to " .. tabName)
    end
end

for name, btn in pairs(tabButtons) do
    btn.MouseButton1Click:Connect(function()
        SwitchTab(name)
    end)
end

