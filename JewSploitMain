    f.ZIndex = 10
    f.Parent = CA
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, 4)

    local lb = Instance.new("TextLabel")
    lb.Size = UDim2.new(1, -60, 1, 0)
    lb.Position = UDim2.new(0, 10, 0, 0)
    lb.BackgroundTransparency = 1
    lb.Font = Enum.Font.Code
    lb.TextSize = 11
    lb.TextColor3 = Color3.fromRGB(0, 200, 0)
    lb.TextXAlignment = Enum.TextXAlignment.Left
    lb.Text = text
    lb.ZIndex = 11
    lb.Parent = f

    local tg = Instance.new("TextButton")
    tg.Size = UDim2.new(0, 44, 0, 20)
    tg.Position = UDim2.new(1, -52, 0.5, -10)
    tg.BackgroundColor3 = Color3.fromRGB(30, 0, 0)
    tg.Font = Enum.Font.Code
    tg.TextSize = 10
    tg.TextColor3 = Color3.fromRGB(200, 50, 50)
    tg.Text = "[OFF]"
    tg.ZIndex = 12
    tg.Parent = f
    Instance.new("UICorner", tg).CornerRadius = UDim.new(0, 3)

    local on = false
    tg.MouseButton1Click:Connect(function()
        on = not on
